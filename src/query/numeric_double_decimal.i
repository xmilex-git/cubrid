/* e == 0 ? 1 : ceil (log_2 (5^e)), exact up to e = 3528 */
static inline uint32_t
numeric_dbl_pow5_bits (const int32_t e)
{
  assert (e >= 0 && e <= 3528);
  return ((((uint32_t) e) * 1217359) >> 19) + 1;
}

/* floor (log_10 (2^e)), exact up to e = 1650 */
static inline int32_t
numeric_dbl_log10_pow2 (const int32_t e)
{
  assert (e >= 0 && e <= 1650);
  return (int32_t) ((((uint32_t) e) * 78913) >> 18);
}

/* floor (log_10 (5^e)), exact up to e = 2620 */
static inline int32_t
numeric_dbl_log10_pow5 (const int32_t e)
{
  assert (e >= 0 && e <= 2620);
  return (int32_t) ((((uint32_t) e) * 732923) >> 20);
}

static inline uint64_t
numeric_dbl_div5 (const uint64_t x)
{
  return x / 5;
}

static inline uint64_t
numeric_dbl_div10 (const uint64_t x)
{
  return x / 10;
}

static inline uint64_t
numeric_dbl_div100 (const uint64_t x)
{
  return x / 100;
}

static inline uint32_t
numeric_dbl_pow5_factor (uint64_t value)
{
  uint32_t count = 0;

  for (;;)
    {
      const uint64_t q = numeric_dbl_div5 (value);
      const uint32_t r = (uint32_t) (value - 5 * q);

      assert (value != 0);
      if (r != 0)
	{
	  break;
	}
      value = q;
      ++count;
    }
  return count;
}

/* true if value is divisible by 5^p */
static inline bool
numeric_dbl_is_multiple_of_pow5 (const uint64_t value, const uint32_t p)
{
  return numeric_dbl_pow5_factor (value) >= p;
}

/* true if value is divisible by 2^p */
static inline bool
numeric_dbl_is_multiple_of_pow2 (const uint64_t value, const uint32_t p)
{
  return (value & ((UINT64_C (1) << p) - 1)) == 0;
}

/* the top 64 bits of m (at most 55 significant bits) times the 128-bit mul, shifted right by j (j >= 115) */
static inline uint64_t
numeric_dbl_mul_shift (const uint64_t m, const uint64_t * const mul, const int32_t j)
{
  const uint128_t b0 = ((uint128_t) m) * mul[0];
  const uint128_t b2 = ((uint128_t) m) * mul[1];

  return (uint64_t) (((b0 >> 64) + b2) >> (j - 64));
}

static inline uint64_t
numeric_dbl_mul_shift_all (const uint64_t m, const uint64_t * const mul, const int32_t j, uint64_t * const vp,
			   uint64_t * const vm, const uint32_t mm_shift)
{
  *vp = numeric_dbl_mul_shift (4 * m + 2, mul, j);
  *vm = numeric_dbl_mul_shift (4 * m - 1 - mm_shift, mul, j);
  return numeric_dbl_mul_shift (4 * m, mul, j);
}

/*
 * numeric_double_to_shortest () - the shortest decimal in the rounding interval of a finite nonzero double, the
 *				   one nearest to it when there are several
 *   return: mantissa (at most 17 digits, may end in zeros only when it is the nearest) and exponent
 *   ieee_mantissa(in), ieee_exponent(in): the fields of the double's bit pattern
 */
static inline NUMERIC_DBL_DECIMAL
numeric_double_to_shortest (const uint64_t ieee_mantissa, const uint32_t ieee_exponent)
{
  int32_t e2;
  uint64_t m2;
  NUMERIC_DBL_DECIMAL fd;

  if (ieee_exponent == 0)
    {
      /* subtract 2 so that the bounds computation has 2 additional bits */
      e2 = 1 - NUMERIC_DBL_BIAS - NUMERIC_DBL_MANTISSA_BITS - 2;
      m2 = ieee_mantissa;
    }
  else
    {
      e2 = ieee_exponent - NUMERIC_DBL_BIAS - NUMERIC_DBL_MANTISSA_BITS - 2;
      m2 = (UINT64_C (1) << NUMERIC_DBL_MANTISSA_BITS) | ieee_mantissa;
    }

  const bool even = (m2 & 1) == 0;
  const bool accept_bounds = even;

  /* step 2: the interval of legal decimal representations */
  const uint64_t mv = 4 * m2;
  const uint32_t mm_shift = ieee_mantissa != 0 || ieee_exponent <= 1;

  /* step 3: convert to a decimal power base using 128-bit arithmetic */
  uint64_t vr, vp, vm;
  int32_t e10;
  bool vm_is_trailing_zeros = false;
  bool vr_is_trailing_zeros = false;

  if (e2 >= 0)
    {
      const uint32_t q = numeric_dbl_log10_pow2 (e2) - (e2 > 3);
      const int32_t k = NUMERIC_DBL_POW5_INV_BITCOUNT + numeric_dbl_pow5_bits (q) - 1;
      const int32_t i = -e2 + q + k;

      e10 = q;
      vr = numeric_dbl_mul_shift_all (m2, NUMERIC_DBL_POW5_INV_SPLIT[q], i, &vp, &vm, mm_shift);

      if (q <= 21)
	{
	  /* only one of mp, mv and mm can be a multiple of 5, if any */
	  const uint32_t mv_mod5 = (uint32_t) (mv - 5 * numeric_dbl_div5 (mv));

	  if (mv_mod5 == 0)
	    {
	      vr_is_trailing_zeros = numeric_dbl_is_multiple_of_pow5 (mv, q);
	    }
	  else if (accept_bounds)
	    {
	      vm_is_trailing_zeros = numeric_dbl_is_multiple_of_pow5 (mv - 1 - mm_shift, q);
	    }
	  else
	    {
	      vp -= numeric_dbl_is_multiple_of_pow5 (mv + 2, q);
	    }
	}
    }
  else
    {
      const uint32_t q = numeric_dbl_log10_pow5 (-e2) - (-e2 > 1);
      const int32_t i = -e2 - q;
      const int32_t k = numeric_dbl_pow5_bits (i) - NUMERIC_DBL_POW5_BITCOUNT;
      const int32_t j = q - k;

      e10 = q + e2;
      vr = numeric_dbl_mul_shift_all (m2, NUMERIC_DBL_POW5_SPLIT[i], j, &vp, &vm, mm_shift);

      if (q <= 1)
	{
	  /* mv = 4 * m2 always has at least two trailing 0 bits */
	  vr_is_trailing_zeros = true;
	  if (accept_bounds)
	    {
	      /* mm = mv - 1 - mm_shift has 1 trailing 0 bit iff mm_shift == 1 */
	      vm_is_trailing_zeros = mm_shift == 1;
	    }
	  else
	    {
	      /* mp = mv + 2 always has at least one trailing 0 bit */
	      --vp;
	    }
	}
      else if (q < 63)
	{
	  vr_is_trailing_zeros = numeric_dbl_is_multiple_of_pow2 (mv, q - 1);
	}
    }

  /* step 4: the shortest decimal representation in the interval */
  int32_t removed = 0;
  uint8_t last_removed_digit = 0;
  uint64_t output;

  if (vm_is_trailing_zeros || vr_is_trailing_zeros)
    {
      /* general case, rare (~0.7%) */
      for (;;)
	{
	  const uint64_t vp_div10 = numeric_dbl_div10 (vp);
	  const uint64_t vm_div10 = numeric_dbl_div10 (vm);

	  if (vp_div10 <= vm_div10)
	    {
	      break;
	    }

	  const uint32_t vm_mod10 = (uint32_t) (vm - 10 * vm_div10);
	  const uint64_t vr_div10 = numeric_dbl_div10 (vr);
	  const uint32_t vr_mod10 = (uint32_t) (vr - 10 * vr_div10);

	  vm_is_trailing_zeros &= vm_mod10 == 0;
	  vr_is_trailing_zeros &= last_removed_digit == 0;
	  last_removed_digit = (uint8_t) vr_mod10;
	  vr = vr_div10;
	  vp = vp_div10;
	  vm = vm_div10;
	  ++removed;
	}

      if (vm_is_trailing_zeros)
	{
	  for (;;)
	    {
	      const uint64_t vm_div10 = numeric_dbl_div10 (vm);
	      const uint32_t vm_mod10 = (uint32_t) (vm - 10 * vm_div10);

	      if (vm_mod10 != 0)
		{
		  break;
		}

	      const uint64_t vp_div10 = numeric_dbl_div10 (vp);
	      const uint64_t vr_div10 = numeric_dbl_div10 (vr);
	      const uint32_t vr_mod10 = (uint32_t) (vr - 10 * vr_div10);

	      vr_is_trailing_zeros &= last_removed_digit == 0;
	      last_removed_digit = (uint8_t) vr_mod10;
	      vr = vr_div10;
	      vp = vp_div10;
	      vm = vm_div10;
	      ++removed;
	    }
	}

      if (vr_is_trailing_zeros && last_removed_digit == 5 && vr % 2 == 0)
	{
	  /* round even if the exact number is .....50..0 */
	  last_removed_digit = 4;
	}

      /* take vr + 1 if vr is outside the bounds or must round up */
      output = vr + ((vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || last_removed_digit >= 5);
    }
  else
    {
      /* specialized for the common case (~99.3%) */
      bool round_up = false;
      const uint64_t vp_div100 = numeric_dbl_div100 (vp);
      const uint64_t vm_div100 = numeric_dbl_div100 (vm);

      if (vp_div100 > vm_div100)
	{
	  /* remove two digits at a time (~86.2%) */
	  const uint64_t vr_div100 = numeric_dbl_div100 (vr);
	  const uint32_t vr_mod100 = (uint32_t) (vr - 100 * vr_div100);

	  round_up = vr_mod100 >= 50;
	  vr = vr_div100;
	  vp = vp_div100;
	  vm = vm_div100;
	  removed += 2;
	}

      for (;;)
	{
	  const uint64_t vp_div10 = numeric_dbl_div10 (vp);
	  const uint64_t vm_div10 = numeric_dbl_div10 (vm);

	  if (vp_div10 <= vm_div10)
	    {
	      break;
	    }

	  const uint64_t vr_div10 = numeric_dbl_div10 (vr);
	  const uint32_t vr_mod10 = (uint32_t) (vr - 10 * vr_div10);

	  round_up = vr_mod10 >= 5;
	  vr = vr_div10;
	  vp = vp_div10;
	  vm = vm_div10;
	  ++removed;
	}

      /* take vr + 1 if vr is outside the bounds or must round up */
      output = vr + (vr == vm || round_up);
    }

  fd.exponent = e10 + removed;
  fd.mantissa = output;
  return fd;
}

/*
 * numeric_double_to_shortest_small_int () - the decimal of a double that is an integer in [1, 2^53)
 *   return: true if the double is such an integer (fd is set), false otherwise
 *   ieee_mantissa(in), ieee_exponent(in): the fields of the double's bit pattern
 *   fd(out): the integer and exponent 0; the integer may end in zeros
 */
static inline bool
numeric_double_to_shortest_small_int (const uint64_t ieee_mantissa, const uint32_t ieee_exponent,
				      NUMERIC_DBL_DECIMAL * fd)
{
  const int32_t e2 = (int32_t) ieee_exponent - NUMERIC_DBL_BIAS - NUMERIC_DBL_MANTISSA_BITS;

  if (e2 >= -NUMERIC_DBL_MANTISSA_BITS && e2 <= 0)
    {
      /* 2^52 <= m2 < 2^53 and 0 <= -e2 <= 52: the double is an integer iff the low -e2 bits are 0 */
      const uint64_t mask = (UINT64_C (1) << -e2) - 1;
      const uint64_t fraction = ieee_mantissa & mask;

      if (fraction == 0)
	{
	  const uint64_t m2 = (UINT64_C (1) << NUMERIC_DBL_MANTISSA_BITS) | ieee_mantissa;

	  fd->mantissa = m2 >> -e2;
	  fd->exponent = 0;
	  return true;
	}
    }
  return false;
}

/*
 * numeric_double_to_decimal () - the shortest decimal that reads back as a finite nonzero double, without trailing
 *				  zeros (the digits of _dtoa () mode 0)
 *   return: mantissa and exponent; the sign is not included
 *   d(in): finite, nonzero
 */
static inline NUMERIC_DBL_DECIMAL
numeric_double_to_decimal (double d)
{
  uint64_t bits;
  NUMERIC_DBL_DECIMAL fd;

  memcpy (&bits, &d, sizeof (bits));

  const uint64_t ieee_mantissa = bits & ((UINT64_C (1) << NUMERIC_DBL_MANTISSA_BITS) - 1);
  const uint32_t ieee_exponent =
    (uint32_t) ((bits >> NUMERIC_DBL_MANTISSA_BITS) & ((1u << NUMERIC_DBL_EXPONENT_BITS) - 1));

  if (!numeric_double_to_shortest_small_int (ieee_mantissa, ieee_exponent, &fd))
    {
      fd = numeric_double_to_shortest (ieee_mantissa, ieee_exponent);
    }

  /* _dtoa () drops trailing zeros; the small-int path keeps them */
  for (;;)
    {
      const uint64_t q = numeric_dbl_div10 (fd.mantissa);

      if (fd.mantissa != 10 * q)
	{
	  break;
	}
      fd.mantissa = q;
      ++fd.exponent;
    }
  return fd;
}
